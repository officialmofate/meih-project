{
  "version": 2,
  "builds": [
    {
      "src": "meih/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "outputDirectory": "meih/frontend",
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/pages/(.*)", "dest": "/pages/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "MEIH_API_URL": "@meih-api-url"
  }
}
