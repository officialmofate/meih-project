# === MEIH Docker Deployment Environment Template ===
# Copy to .env:  cp .env.example .env   (or)   copy .env.example .env
# Then edit the values. Generated secrets are shown as "change-me".

# ── App ──────────────────────────────────────────────
# Host port that maps to the container's 3000. In Dokploy set this to expose the app.
APP_PORT=3000
NODE_ENV=production
PORT=3000

# Make sure these match the app's public URL (used for email links + CORS).
FRONTEND_URL=http://localhost:3000
# Comma-separated list of extra allowed CORS origins (optional).
CORS_ORIGINS=

# ── Database (local Postgres via compose) ────────────
POSTGRES_DB=meih
POSTGRES_USER=meih_user
POSTGRES_PASSWORD=change-me-postgres-password
DB_POOL_MAX=30

# To use an EXTERNAL database instead (e.g. Supabase / managed Postgres),
# set DATABASE_URL and it overrides the compose Postgres for the app:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Redis helper (compose provides a local one; no password for redis:7 here) ──
# REDIS_URL=redis://redis:6379

# ── JWT ──────────────────────────────────────────────
# REQUIRED. Generate strong random secrets:
#   openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret-generate-long-random
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-generate-long-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI (Gemini) — optional, leave blank to disable ──
GEMINI_API_KEY=

# ── SMTP (email verification/notifications) — optional ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@meih.co.tz
