PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://meih_user:meih_secret@localhost:5432/meih

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / R2 (optional)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# AI (Gemini)
GEMINI_API_KEY=

# Payment providers (optional — add keys when ready to integrate)
MPESA_API_KEY=
AIRTEL_MONEY_API_KEY=
HALOPESA_API_KEY=
SELCOM_API_KEY=
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
